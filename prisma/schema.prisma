generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// id = Supabase Auth user id (uuid). Created on first login.
model User {
  id             String            @id
  email          String            @unique
  name           String            @default("")
  telegramChatId String?           @unique
  telegramCode   String?           @unique // one-time code used to link the chat
  notifyDays     Int               @default(3) // days before a due date to warn
  notifyHour     Int               @default(9) // local hour for the daily digest
  dashboard      Json? // { cards: [{id, size}], accountIds: [] }
  createdAt      DateTime          @default(now())
  accounts       Account[]
  categories     Category[]
  tags           Tag[]
  transactions   Transaction[]
  plans          InstallmentPlan[]
  planned        Planned[]
}

model Account {
  id             Int               @id @default(autoincrement())
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  type           String // CASH | BANK | CREDIT_CARD | WALLET | SAVINGS
  currency       String // ARS | USD | ...
  color          String            @default("#1A9D76")
  initialBalance Float             @default(0)
  sortOrder      Int               @default(0)
  includeInStats Boolean           @default(true) // counts towards dashboard KPIs
  archived       Boolean           @default(false)
  creditLimit    Float? // CREDIT_CARD only
  closingDay     Int? // CREDIT_CARD: statement closing day of month
  dueDay         Int? // CREDIT_CARD: payment due day of month
  lastNotifiedOn DateTime? // dedupes the card due-date reminder
  createdAt      DateTime          @default(now())
  transactions   Transaction[]     @relation("AccountTx")
  transfersIn    Transaction[]     @relation("ToAccountTx")
  installments   InstallmentPlan[]
  planned        Planned[]

  @@index([userId])
}

model Category {
  id           Int               @id @default(autoincrement())
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  kind         String // INCOME | EXPENSE
  color        String            @default("#6B7280")
  icon         String            @default("tag")
  nature       String            @default("NEED") // MUST | NEED | WANT (expense nature)
  sortOrder    Int               @default(0)
  parentId     Int? // one level of nesting: parent categories group subcategories
  parent       Category?         @relation("Subcategories", fields: [parentId], references: [id], onDelete: Cascade)
  children     Category[]        @relation("Subcategories")
  transactions Transaction[]
  installments InstallmentPlan[]
  planned      Planned[]

  @@unique([userId, name, parentId])
  @@index([userId])
}

model Tag {
  id           Int           @id @default(autoincrement())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  color        String        @default("#24C092")
  transactions Transaction[]

  @@unique([userId, name])
}

model Transaction {
  id            Int              @id @default(autoincrement())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String // INCOME | EXPENSE | TRANSFER
  amount        Float
  currency      String
  date          DateTime // includes time of day
  dueDate       DateTime? // optional payment deadline (e.g. a bill)
  paid          Boolean          @default(true)
  description   String           @default("")
  note          String           @default("")
  accountId     Int
  account       Account          @relation("AccountTx", fields: [accountId], references: [id], onDelete: Cascade)
  toAccountId   Int?
  toAccount     Account?         @relation("ToAccountTx", fields: [toAccountId], references: [id], onDelete: Cascade)
  toAmount      Float? // amount received in destination currency (transfers)
  categoryId    Int?
  category      Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags          Tag[]
  planId        Int?
  plan          InstallmentPlan? @relation(fields: [planId], references: [id], onDelete: Cascade)
  installmentNo Int?
  attachments   Attachment[]
  createdAt     DateTime         @default(now())

  @@index([userId, date])
  @@index([accountId])
  @@index([userId, dueDate])
}

model InstallmentPlan {
  id           Int           @id @default(autoincrement())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  description  String
  totalAmount  Float
  installments Int
  startDate    DateTime
  accountId    Int
  account      Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  categoryId   Int?
  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  transactions Transaction[]
  createdAt    DateTime      @default(now())

  @@index([userId])
}

/// Future money: expected income (salary, refunds) and upcoming bills.
model Planned {
  id             Int       @id @default(autoincrement())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           String // INCOME | EXPENSE
  description    String
  amount         Float
  currency       String
  dueDate        DateTime
  recurrence     String    @default("NONE") // NONE | WEEKLY | MONTHLY | YEARLY
  accountId      Int?
  account        Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  categoryId     Int?
  category       Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  notify         Boolean   @default(true)
  done           Boolean   @default(false)
  lastNotifiedOn DateTime?
  createdAt      DateTime  @default(now())

  @@index([userId, dueDate])
}

model Attachment {
  id            Int         @id @default(autoincrement())
  transactionId Int
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  storagePath   String // path inside the Supabase Storage bucket
  mimeType      String
  source        String      @default("WEB") // WEB | TELEGRAM
  createdAt     DateTime    @default(now())
}
