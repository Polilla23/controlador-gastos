generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// id = Supabase Auth user id (uuid). Created on first login.
model User {
  id             String            @id
  email          String            @unique
  name           String            @default("")
  telegramChatId String?           @unique
  telegramCode   String?           @unique // one-time code used to link the chat
  notifyDays     Int               @default(3) // days before a due date to warn
  notifyHour     Int               @default(9) // local hour for the daily digest
  dashboard      Json? // { cards: [{id, size}], accountIds: [] }
  createdAt      DateTime          @default(now())
  accounts       Account[]
  categories     Category[]
  tags           Tag[]
  transactions   Transaction[]
  plans          InstallmentPlan[]
  planned        Planned[]
  filters        SavedFilter[]
  budgets        Budget[]
  goals          Goal[]
  debts          Debt[]
  rules          Rule[]
  groups         ShareGroup[]
  holdings       Holding[]
  investMoves    InvestMove[]
}

model Account {
  id             Int               @id @default(autoincrement())
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  icon           String? // ícono elegido en el selector (ej "mdi:bank")
  type           String // CASH | BANK | CREDIT_CARD | WALLET | SAVINGS
  currency       String // ARS | USD | ...
  color          String            @default("#1A9D76")
  initialBalance Float             @default(0)
  sortOrder      Int               @default(0)
  includeInStats Boolean           @default(true) // counts towards dashboard KPIs
  archived       Boolean           @default(false)
  creditLimit    Float? // CREDIT_CARD only
  closingDay     Int? // CREDIT_CARD: statement closing day of month
  dueDay         Int? // CREDIT_CARD: payment due day of month
  lastNotifiedOn DateTime? // dedupes the card due-date reminder
  createdAt      DateTime          @default(now())
  transactions   Transaction[]     @relation("AccountTx")
  transfersIn    Transaction[]     @relation("ToAccountTx")
  installments   InstallmentPlan[]
  planned        Planned[]
  budgets        Budget[]
  debts          Debt[]
  holdings       Holding[]
  investMoves    InvestMove[]

  @@index([userId])
}

model Category {
  id           Int               @id @default(autoincrement())
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  kind         String // INCOME | EXPENSE
  color        String            @default("#6B7280")
  icon         String            @default("tag")
  nature       String            @default("NEED") // MUST | NEED | WANT (expense nature)
  sortOrder    Int               @default(0)
  parentId     Int? // one level of nesting: parent categories group subcategories
  parent       Category?         @relation("Subcategories", fields: [parentId], references: [id], onDelete: Cascade)
  children     Category[]        @relation("Subcategories")
  transactions Transaction[]
  installments InstallmentPlan[]
  planned      Planned[]
  budgets      Budget[]
  rules        Rule[]

  @@unique([userId, name, parentId])
  @@index([userId])
}

model Tag {
  id           Int           @id @default(autoincrement())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  color        String        @default("#24C092")
  icon         String? // nombre del ícono elegido en el selector
  sortOrder    Int           @default(0)
  transactions Transaction[]
  planned      Planned[]
  budgets      Budget[]
  rules        Rule[]

  @@unique([userId, name])
}

model Transaction {
  id            Int              @id @default(autoincrement())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String // INCOME | EXPENSE | TRANSFER
  amount        Float
  currency      String
  date          DateTime // includes time of day
  dueDate       DateTime? // optional payment deadline (e.g. a bill)
  paid          Boolean          @default(true)
  description   String           @default("")
  note          String           @default("")
  counterparty  String           @default("") // quién me pagó o a quién le pagué
  warrantyMonths Int? // garantía del producto, en meses
  splitGroup    String? // agrupa los registros nacidos de dividir uno solo
  fxRate        Float? // cotización usada para convertir a la moneda principal
  statementMonth String? // "YYYY-MM": resumen de tarjeta en el que cae el consumo
  accountId     Int
  account       Account          @relation("AccountTx", fields: [accountId], references: [id], onDelete: Cascade)
  toAccountId   Int?
  toAccount     Account?         @relation("ToAccountTx", fields: [toAccountId], references: [id], onDelete: Cascade)
  toAmount      Float? // amount received in destination currency (transfers)
  categoryId    Int?
  category      Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags          Tag[]
  planId        Int?
  plan          InstallmentPlan? @relation(fields: [planId], references: [id], onDelete: Cascade)
  installmentNo Int?
  attachments   Attachment[]
  createdAt     DateTime         @default(now())

  @@index([userId, date])
  @@index([accountId])
  @@index([userId, dueDate])
  @@index([userId, counterparty])
  @@index([splitGroup])
}

model InstallmentPlan {
  id           Int           @id @default(autoincrement())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  description  String
  totalAmount  Float
  installments Int
  startDate    DateTime
  accountId    Int
  account      Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  categoryId   Int?
  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  transactions Transaction[]
  createdAt    DateTime      @default(now())

  @@index([userId])
}

/// Future money: expected income (salary, refunds) and upcoming bills.
model Planned {
  id             Int       @id @default(autoincrement())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           String // INCOME | EXPENSE
  description    String
  amount         Float
  currency       String
  dueDate        DateTime
  recurrence     String    @default("NONE") // NONE | WEEKLY | MONTHLY | YEARLY
  accountId      Int?
  account        Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  categoryId     Int?
  category       Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags           Tag[]
  notify         Boolean   @default(true)
  done           Boolean   @default(false)
  lastNotifiedOn DateTime?
  createdAt      DateTime  @default(now())

  @@index([userId, dueDate])
}

/// Filtros guardados por el usuario, reutilizables en Registros y Resumen.
model SavedFilter {
  id        Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  scope     String   @default("TX") // TX (registros) | DASHBOARD (resumen)
  query     Json // los parámetros de búsqueda tal cual van en la URL
  createdAt DateTime @default(now())

  @@unique([userId, scope, name])
  @@index([userId, scope])
}

/// Cuánto pienso gastar en un período, y en qué.
model Budget {
  id         Int        @id @default(autoincrement())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  period     String     @default("MONTHLY") // ONCE | WEEKLY | MONTHLY | YEARLY
  amount     Float
  currency   String     @default("ARS")
  startDate  DateTime
  endDate    DateTime? // sólo para los de una vez
  note       String     @default("")
  color      String     @default("#1A9D76")
  icon       String?
  archived   Boolean    @default(false)
  /// Último período en el que ya avisamos que se pasó ("YYYY-MM-DD" del inicio).
  warnedFor  String?
  categories Category[]
  accounts   Account[]
  tags       Tag[]
  createdAt  DateTime   @default(now())

  @@index([userId, archived])
}

/// Un objetivo de ahorro, con los aportes que se le van haciendo.
model Goal {
  id            Int                @id @default(autoincrement())
  userId        String
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  targetAmount  Float
  currency      String             @default("ARS")
  targetDate    DateTime?
  status        String             @default("ACTIVE") // ACTIVE | PAUSED | REACHED
  color         String             @default("#22C55E")
  icon          String?
  note          String             @default("")
  createdAt     DateTime           @default(now())
  contributions GoalContribution[]

  @@index([userId, status])
}

model GoalContribution {
  id     Int      @id @default(autoincrement())
  goalId Int
  goal   Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  amount Float // negativo si se retira plata del objetivo
  date   DateTime @default(now())
  note   String   @default("")

  @@index([goalId, date])
}

/* ---------- Deudas ---------- */

/// Plata prestada o pedida prestada, fuera del circuito de gastos.
model Debt {
  id             Int           @id @default(autoincrement())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  direction      String // I_LENT (le presté) | I_OWE (me prestaron)
  counterparty   String // a quién / quién
  description    String        @default("")
  amount         Float
  currency       String        @default("ARS")
  date           DateTime // cuándo se hizo
  dueDate        DateTime? // cuándo hay que devolverla
  accountId      Int?
  account        Account?      @relation(fields: [accountId], references: [id], onDelete: SetNull)
  status         String        @default("OPEN") // OPEN | CLOSED
  notify         Boolean       @default(true)
  lastNotifiedOn DateTime?
  createdAt      DateTime      @default(now())
  payments       DebtPayment[]

  @@index([userId, status])
}

/// Cada devolución parcial o total de una deuda.
model DebtPayment {
  id            Int      @id @default(autoincrement())
  debtId        Int
  debt          Debt     @relation(fields: [debtId], references: [id], onDelete: Cascade)
  amount        Float
  date          DateTime @default(now())
  transactionId Int? // el movimiento que generó, si se registró
  note          String   @default("")

  @@index([debtId])
}

/* ---------- Cotizaciones ---------- */

/// Última cotización conocida de cada tipo de dólar, cacheada de dolarapi.com.
model Quote {
  id        Int      @id @default(autoincrement())
  code      String   @unique // oficial | blue | bolsa | contadoconliqui | tarjeta | cripto | mayorista
  name      String
  buy       Float?
  sell      Float?
  fetchedAt DateTime @default(now())
  quotedAt  DateTime?
}

/* ---------- Reglas de automatización ---------- */

/// Aplica categoría, etiquetas y descripción a los registros que coinciden.
model Rule {
  id              Int       @id @default(autoincrement())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  active          Boolean   @default(true)
  sortOrder       Int       @default(0)
  /// Palabras separadas por coma; se buscan en descripción, contraparte y nota.
  keywords        String    @default("")
  matchType       String    @default("ANY") // ANY | INCOME | EXPENSE | TRANSFER
  matchAccountId  Int?
  matchToAccountId Int?
  setCategoryId   Int?
  setCategory     Category? @relation(fields: [setCategoryId], references: [id], onDelete: SetNull)
  setDescription  String    @default("")
  setCounterparty String    @default("")
  setTags         Tag[]
  createdAt       DateTime  @default(now())

  @@index([userId, active])
}

/* ---------- Gastos compartidos ---------- */

model ShareGroup {
  id        Int            @id @default(autoincrement())
  userId    String // quien lo creó
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  currency  String         @default("ARS")
  note      String         @default("")
  archived  Boolean        @default(false)
  createdAt DateTime       @default(now())
  members   ShareMember[]
  expenses  ShareExpense[]

  @@index([userId, archived])
}

model ShareMember {
  id        Int            @id @default(autoincrement())
  groupId   Int
  group     ShareGroup     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name      String
  email     String         @default("")
  /// Si es el propio dueño del grupo, para saber qué saldo es "mío".
  isMe      Boolean        @default(false)
  paid      ShareExpense[] @relation("PagadoPor")
  splits    ShareSplit[]

  @@index([groupId])
}

model ShareExpense {
  id          Int          @id @default(autoincrement())
  groupId     Int
  group       ShareGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  description String
  amount      Float
  date        DateTime
  paidById    Int
  paidBy      ShareMember  @relation("PagadoPor", fields: [paidById], references: [id], onDelete: Cascade)
  categoryId  Int?
  note        String       @default("")
  createdAt   DateTime     @default(now())
  splits      ShareSplit[]

  @@index([groupId, date])
}

/// Cuánto de un gasto le toca a cada integrante.
model ShareSplit {
  id        Int          @id @default(autoincrement())
  expenseId Int
  expense   ShareExpense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  memberId  Int
  member    ShareMember  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  amount    Float

  @@index([expenseId])
}

/* ---------- Inversiones ---------- */

/// Una tenencia dentro de una cuenta de inversión (un CEDEAR, un FCI, un plazo fijo…).
model Holding {
  id        Int          @id @default(autoincrement())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId Int
  account   Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  kind      String // CEDEAR | ACCION | BONO | LETRA | FCI | PLAZO_FIJO | CAUCION | ON | CRIPTO | OTRO
  ticker    String       @default("")
  name      String
  currency  String       @default("ARS")
  /// Datos propios de renta fija: tasa anual y vencimiento.
  rate      Float?
  maturity  DateTime?
  note      String       @default("")
  createdAt DateTime     @default(now())
  moves     InvestMove[]

  @@index([userId, accountId])
}

/// Compras, ventas, aportes y rentas dentro de una cuenta de inversión.
model InvestMove {
  id        Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId Int
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  holdingId Int?
  holding   Holding? @relation(fields: [holdingId], references: [id], onDelete: Cascade)
  type      String // BUY | SELL | DEPOSIT | WITHDRAW | INCOME (renta) | FEE
  quantity  Float? // nominales, cuotapartes…
  price     Float? // precio unitario
  amount    Float // plata que entra o sale de la cuenta
  currency  String   @default("ARS")
  date      DateTime
  note      String   @default("")
  createdAt DateTime @default(now())

  @@index([userId, date])
  @@index([accountId])
}

model Attachment {
  id            Int         @id @default(autoincrement())
  transactionId Int
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  storagePath   String // path inside the Supabase Storage bucket
  mimeType      String
  source        String      @default("WEB") // WEB | TELEGRAM
  createdAt     DateTime    @default(now())
}
