# Supabase → Connect → ORMs → Prisma
# "Transaction" pooler (6543) for the app, direct/session (5432) for migrations.
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Supabase → Project Settings → API (la URL va sin /rest/v1)
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
SUPABASE_SERVICE_ROLE_KEY="eyJ..."   # solo servidor, nunca exponer

# Telegram → hablale a @BotFather → /newbot
TELEGRAM_BOT_TOKEN="123456789:AA..."
# OBLIGATORIA si usás el bot: tiene que ser la misma que el `secret_token` con el que
# registrás el webhook (setWebhook). Si falta, /api/telegram responde 503.
TELEGRAM_WEBHOOK_SECRET="una-frase-secreta-que-inventes"
NEXT_PUBLIC_TELEGRAM_BOT="MiFinanzasBot"   # usuario del bot, sin @

# OBLIGATORIA. Protege /api/cron/recordatorios y /api/health; si falta, esos endpoints
# responden 503 (el cron diario NO corre). Vercel la manda sola como
# "Authorization: Bearer <CRON_SECRET>" en cada corrida programada.
CRON_SECRET="otra-frase-secreta"

# Opcional: sincronizar vencimientos con Google Calendar (Perfil → Conectar Google).
# Google Cloud Console → proyecto con la Calendar API habilitada → credenciales
# OAuth "aplicación web". Hacen falta las TRES; si falta alguna la función queda apagada.
# La URI de redirección tiene que estar registrada tal cual en Google Cloud.
# GOOGLE_CLIENT_ID="xxxx.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="GOCSPX-..."
# GOOGLE_REDIRECT_URI="https://TU-APP.vercel.app/api/auth/google/callback"

# Opcional. La app ya calcula meses, semanas y vencimientos con el calendario
# argentino sin configurar nada; esto solo sirve para usar otra zona horaria.
# (No usar TZ: Vercel la tiene reservada y la ignora.)
# APP_TIMEZONE="America/Argentina/Buenos_Aires"
